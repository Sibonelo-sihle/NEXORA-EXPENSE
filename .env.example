# Browser: public Supabase values only
VITE_SUPABASE_URL=https://your_project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_public_key
# Server only. Never prefix any of these with VITE_.
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
APP_ORIGIN=https://your_staging_domain
PAYFAST_NOTIFY_URL=https://your_staging_domain/api/payfast/notify
PAYFAST_MODE=sandbox
PAYFAST_LIVE_ENABLED=false
PAYFAST_MERCHANT_ID=your_sandbox_merchant_id
PAYFAST_MERCHANT_KEY=your_sandbox_merchant_key
PAYFAST_PASSPHRASE=your_sandbox_passphrase
PORT=3001
# Only exact trusted reverse-proxy IPs/CIDRs; leave empty for direct connections.
TRUSTED_PROXY_CIDRS=

# Split hosting: approved public build origins (leave empty in local development).
VITE_API_URL=
VITE_APP_ORIGIN=
CORS_ORIGINS=
RELEASE_SANDBOX_ONLY=true
